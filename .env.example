OPENROUTER_API_KEY=<your openroute key>
DOUBLEWORD_API_KEY=<your doubleword key>
# Disable auto-sync to preserve manual model identifier corrections
SKIP_DOUBLEWORD_SYNC=1
V7_GO_API_KEY=<your v7go key>
V7_GO_WORKSPACE_ID=<your v7go workspace id>
V7_GO_AGENT_ID=<your v7go agent id>
V7_GO_PDF_DIR="data"
# Only for child/collection agents: parent *entity* UUID from the parent project — never the same as V7_GO_AGENT_ID.
# V7_GO_PARENT_ENTITY_ID=
# Use go.v7labs.com (OpenAPI default). api.go.v7labs.com does not resolve on many networks.
V7_GO_BASE_URL="https://go.v7labs.com"
V7_GO_AUTO_ENSURE_PROPERTIES=1